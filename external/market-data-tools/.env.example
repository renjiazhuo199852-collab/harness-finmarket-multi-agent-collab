# Embedding 服务配置。
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIMENSIONS=2048
EMBEDDING_API_KEY=填写 Embedding API Key
# 新闻语义检索最低余弦相似度；不是新闻返回条数上限，超过门槛的候选全部保留。
NEWS_EMBEDDING_MIN_SCORE=0.40
# 新闻 pg_trgm 字符相似度门槛；低于该值的短文本重叠不作为新闻候选。
NEWS_TRIGRAM_MIN_SCORE=0.20

# PostgreSQL 连接配置。
# 服务器数据库已经完成初始化；本机运行 tools 时，先在另一个终端保持 SSH
# 隧道运行：ssh -p 22 -L 15433:127.0.0.1:5433 root@101.35.55.7
# 这里的 15433 是本机 SSH 隧道端口，不是服务器 PostgreSQL 的监听端口。
# 密码只放在本机 .env 或启动终端，不提交到 Git。
AI_SEARCH_DB_HOST=127.0.0.1
AI_SEARCH_DB_PORT=15433
AI_SEARCH_DB_NAME=icbc_shared
AI_SEARCH_DB_USER=icbc_collab
AI_SEARCH_DB_PASSWORD=填写数据库密码

# 后续用于候选金融工具判断的 OpenAI 兼容聊天模型配置。
LLM_BASE_URL=https://api.deepseek.com
LLM_CHAT_COMPLETIONS_PATH=/chat/completions
LLM_API_KEY=填写聊天模型 API Key
LLM_MODEL=deepseek-v4-flash
LLM_REASONING_EFFORT=high
